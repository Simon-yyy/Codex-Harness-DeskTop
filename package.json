{
  "name": "codex-desktop",
  "version": "1.1.0",
  "description": "OpenAI Codex Harness Modern Desktop Client (Electron)",
  "main": "main.js",
  "author": "Simon-yyy",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev:ui": "vite",
    "build:ui": "vite build && node scripts/sync-ui.mjs",
    "dev": "concurrently -k \"vite\" \"electron .\"",
    "start": "electron .",
    "pack": "npm run build:ui && electron-builder --dir",
    "build": "npm run build:ui && electron-builder && node scripts/release.mjs",
    "release": "node scripts/release.mjs",
    "test": "node tests/run-all-tests.mjs"
  },
  "build": {
    "appId": "com.simon.codex.desktop",
    "productName": "Codex Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "ui/**/*",
      "assets/**/*",
      ".agents/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Codex Desktop"
    },
    "electronVersion": "33.4.11"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^9.2.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  },
  "repository": "https://github.com/Simon-yyy/Codex-Harness-DeskTop.git",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1"
  }
}
